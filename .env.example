# Copy to .env.local (gitignored) and fill in. Only the PUBLIC anon key goes here, never service_role.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Screen-lock waiters (NOT security — the JSON is bundled into public JS).
# Replace pin "XXXX" with real 4-digit PINs in .env.local; never commit real PINs.
# If this var is missing/invalid, the PDA falls back to the demo list in src/pda/waiters.js.
# Production: set PUBLIC_WAITERS_JSON in Vercel (Production / Preview / Development) and redeploy.
PUBLIC_WAITERS_JSON=[{"id":"marco","pin":"XXXX","name":"Marco","zones":["sala"]},{"id":"sofia","pin":"XXXX","name":"Sofia","zones":["giardino"]},{"id":"luca","pin":"XXXX","name":"Luca","zones":["bancone"]},{"id":"admin","pin":"XXXX","name":"Admin / Caposala","zones":["sala","giardino","bancone"],"admin":true}]

